<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Harley Davidson - Gerenciador de Motos</title>
    <link rel="stylesheet" href="/css/style.css?v=5">
</head>
<body>
    <!-- Tela de Boas-Vindas -->
    <div id="welcome-screen" class="welcome-screen active">
        <div class="welcome-overlay"></div>
        <div class="welcome-content">
            <div class="welcome-logo">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Harley-Davidson_logo.svg/1200px-Harley-Davidson_logo.svg.png" alt="Harley Davidson Logo">
            </div>
            <h1 class="welcome-title">Harley-Davidson</h1>
            <p class="welcome-subtitle">Sistema de Gerenciamento de Motos</p>
            <div class="welcome-tagline">
                <p> Estilo de Vida Sobre Duas Rodas</p>
            </div>
            <button id="start-btn" class="btn-start">
                <span>Iniciar</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    <div class="container">
        <header>
            <div class="header-content">
                <div class="header-logo">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Harley-Davidson_logo.svg/1200px-Harley-Davidson_logo.svg.png" alt="Harley Davidson Logo">
                </div>
                <div class="header-text">
                    <h1> Harley Davidson</h1>
                    <p>Cadastro ou consulta de motos Harley Davidson</p>
                </div>
            </div>
            <div class="header-actions">
                <button class="btn btn-catalog" id="catalog-btn">
                     Catálogo por Motor
                </button>
            </div>
        </header>

        <main>
            <section class="form-section">
                <h2>Cadastrar Nova Moto</h2>
                <form id="motorcycle-form">
                    <div class="form-group">
                        <label for="model">Modelo:</label>
                        <input type="text" id="model" name="model" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="year">Ano:</label>
                        <input type="number" id="year" name="year" min="1903" max="2026" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="color">Cor:</label>
                        <input type="text" id="color" name="color" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="engine">Motor:</label>
                        <input type="text" id="engine" name="engine" placeholder="ex: Milwaukee-Eight 107" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="price">Preço (R$):</label>
                        <input type="number" id="price" name="price" step="0.01" min="0" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Descrição:</label>
                        <textarea id="description" name="description" rows="3"></textarea>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Cadastrar</button>
                        <button type="button" class="btn btn-secondary" id="cancel-btn" style="display: none;">Cancelar</button>
                    </div>
                </form>
            </section>

            <section class="list-section">
                <h2>Motos Cadastradas</h2>
                <div id="motorcycles-list"></div>
            </section>
        </main>
    </div>

    <!-- Modal de Catálogo por Motor -->
    <div id="catalog-modal" class="catalog-modal">
        <div class="catalog-content">
            <div class="catalog-header">
                <h2> Catálogo Harley-Davidson por Tipo de Motor</h2>
                <button class="btn-close" id="close-catalog-btn">✕ Voltar</button>
            </div>
            
            <div class="catalog-search">
                <input type="text" id="catalog-search-input" placeholder="Buscar modelo, motor, categoria...">
                <button id="catalog-search-btn">🔍 Buscar</button>
            </div>

            <div class="catalog-stats" id="catalog-stats"></div>
            
            <div class="catalog-engines" id="catalog-engines"></div>
            
            <div class="catalog-motorcycles" id="catalog-motorcycles"></div>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
