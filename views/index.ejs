<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Harley Davidson - Gerenciador de Motos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>🏍️ Harley Davidson</h1>
            <p>Gerenciador de Cadastros de Motos</p>
        </header>

        <main>
            <section class="form-section">
                <h2>Cadastrar Nova Moto</h2>
                <form id="motorcycle-form">
                    <div class="form-group">
                        <label for="model">Modelo:</label>
                        <input type="text" id="model" name="model" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="year">Ano:</label>
                        <input type="number" id="year" name="year" min="1903" max="2026" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="color">Cor:</label>
                        <input type="text" id="color" name="color" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="engine">Motor:</label>
                        <input type="text" id="engine" name="engine" placeholder="ex: Milwaukee-Eight 107" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="price">Preço (R$):</label>
                        <input type="number" id="price" name="price" step="0.01" min="0" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Descrição:</label>
                        <textarea id="description" name="description" rows="3"></textarea>
                    </div>
                    
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Cadastrar</button>
                        <button type="button" class="btn btn-secondary" id="cancel-btn" style="display: none;">Cancelar</button>
                    </div>
                </form>
            </section>

            <section class="list-section">
                <h2>Motos Cadastradas</h2>
                <div id="motorcycles-list"></div>
            </section>
        </main>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
