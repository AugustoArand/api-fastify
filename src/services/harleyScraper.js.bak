import axios from 'axios';
import * as cheerio from 'cheerio';

/**
 * Serviço de Web Scraping para buscar informações de motos Harley-Davidson
 * de múltiplas fontes online
 */
class HarleyScraper {
  constructor() {
    this.timeout = 15000;
    this.headers = {
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
      'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8',
      'Accept-Language': 'pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7',
      'Accept-Encoding': 'gzip, deflate, br',
      'Connection': 'keep-alive',
      'Upgrade-Insecure-Requests': '1',
      'Sec-Fetch-Dest': 'document',
      'Sec-Fetch-Mode': 'navigate',
      'Sec-Fetch-Site': 'none',
      'Cache-Control': 'max-age=0'
    };
  }

  /**
   * Busca motos do site oficial Harley-Davidson
   */
  async scrapeOfficialSite() {
    try {
      const url = 'https://www.harley-davidson.com/br/pt/motorcycles.html';
      
      const response = await axios.get(url, {
        timeout: this.timeout,
        headers: this.headers
      });

      const $ = cheerio.load(response.data);
      const motorcycles = [];

      // Tentar extrair informações do site oficial
      $('.bike-card, .motorcycle-card, .product-card, [class*="bike"], [class*="motorcycle"]').each((index, element) => {
        const $el = $(element);
        
        const model = $el.find('h2, h3, h4, .title, .model, [class*="title"], [class*="name"]').first().text().trim();
        const price = $el.find('.price, [class*="price"]').first().text().trim();
        const description = $el.find('.description, p, [class*="description"]').first().text().trim();
        const image = $el.find('img').first().attr('src');
        const link = $el.find('a').first().attr('href');

        if (model) {
          motorcycles.push({
            model,
            price: price || 'Consulte a concessionária',
            description: description || 'Informação não disponível',
            image: image ? (image.startsWith('http') ? image : `https://www.harley-davidson.com${image}`) : null,
            link: link ? (link.startsWith('http') ? link : `https://www.harley-davidson.com${link}`) : null,
            source: 'Harley-Davidson Official'
          });
        }
      });

      if (motorcycles.length === 0) {
        return this.getOfficialMockData();
      }

      return motorcycles;
    } catch (error) {
      console.error('Erro ao fazer scraping do site oficial:', error.message);
      return this.getOfficialMockData();
    }
  }

  /**
   * Busca motos da OLX
   * Nota: OLX pode bloquear bots, usando dados mock como fallback
   */
  async scrapeOLX() {
    try {
      // OLX geralmente requer JavaScript/renderização
      // Retornando dados mock para melhor experiência
      console.log('OLX: Usando dados de exemplo (site requer renderização JavaScript)');
      return this.getOLXMockData();
    } catch (error) {
      console.error('Erro ao fazer scraping da OLX:', error.message);
      return this.getOLXMockData();
    }
  }

  /**
   * Busca motos do Mercado Livre
   * Nota: Mercado Livre pode bloquear bots, usando dados mock como fallback
   */
  async scrapeMercadoLivre() {
    try {
      // Mercado Livre usa renderização JavaScript e proteção anti-bot
      console.log('Mercado Livre: Usando dados de exemplo (site protegido contra scraping)');
      return this.getMercadoLivreMockData();
    } catch (error) {
      console.error('Erro ao fazer scraping do Mercado Livre:', error.message);
      return this.getMercadoLivreMockData();
    }
  }

  /**
   * Busca motos da Webmotors
   * Nota: Site pode bloquear bots (erro 403), retornando dados mock
   */
  async scrapeWebmotors() {
    try {
      // Webmotors geralmente bloqueia scrapers (403)
      // Retornando dados mock diretamente para evitar erros
      console.log('Webmotors: Usando dados de exemplo (site protegido contra scraping)');
      return this.getWebmotorsMockData();
    } catch (error) {
      console.error('Erro ao fazer scraping da Webmotors:', error.message);
      return this.getWebmotorsMockData();
    }
  }

  /**
   * Busca de todas as fontes
   */
  async scrapeAll() {
    try {
      const [official, olx, mercadoLivre, webmotors] = await Promise.allSettled([
        this.scrapeOfficialSite(),
        this.scrapeOLX(),
        this.scrapeMercadoLivre(),
        this.scrapeWebmotors()
      ]);

      const allMotorcycles = [];
      
      if (official.status === 'fulfilled') allMotorcycles.push(...official.value);
      if (olx.status === 'fulfilled') allMotorcycles.push(...olx.value);
      if (mercadoLivre.status === 'fulfilled') allMotorcycles.push(...mercadoLivre.value);
      if (webmotors.status === 'fulfilled') allMotorcycles.push(...webmotors.value);

      return allMotorcycles;
    } catch (error) {
      console.error('Erro ao buscar de todas as fontes:', error.message);
      return [...this.getOfficialMockData(), ...this.getOLXMockData()];
    }
  }

  /**
   * Busca por fonte específica
   */
  async scrapeBySource(source) {
    switch (source.toLowerCase()) {
      case 'official':
      case 'harley':
        return await this.scrapeOfficialSite();
      case 'olx':
        return await this.scrapeOLX();
      case 'mercadolivre':
      case 'mercado':
        return await this.scrapeMercadoLivre();
      case 'webmotors':
        return await this.scrapeWebmotors();
      case 'all':
      default:
        return await this.scrapeAll();
    }
  }

  /**
   * Busca com filtro de query
   */
  async searchMotorcycles(query = '', source = 'all') {
    const motorcycles = await this.scrapeBySource(source);
    
    if (!query) {
      return motorcycles;
    }

    const queryLower = query.toLowerCase();
    return motorcycles.filter(moto => 
      moto.model.toLowerCase().includes(queryLower) ||
      (moto.description && moto.description.toLowerCase().includes(queryLower)) ||
      (moto.category && moto.category.toLowerCase().includes(queryLower)) ||
      (moto.engine && moto.engine.toLowerCase().includes(queryLower))
    );
  }

